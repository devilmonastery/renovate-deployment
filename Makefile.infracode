.PHONY: generate generate-check generate-verify

# Infracode
## generate: Render infracode outputs
generate:
	cd infracode && GOWORK=off go run github.com/devilmonastery/infracode/cmd/generator --repo-root .. --manifest-dir infracode render
## generate-check: Validate infracode manifest without writing files
generate-check:
	cd infracode && GOWORK=off go run github.com/devilmonastery/infracode/cmd/generator --repo-root .. --manifest-dir infracode check
## generate-verify: Verify generated infracode outputs
generate-verify:
	cd infracode && GOWORK=off go run github.com/devilmonastery/infracode/cmd/generator --repo-root .. --manifest-dir infracode render --verify

# Repository-maintained targets (Makefile.local, hand-written, not generated).
# Add prerequisites to generated targets here to extend them.
# Redefining a generated target's recipe requires a preceding
# "# infracode:override <target>" comment; without it the local recipe still
# overrides the generated one, and make reports "overriding commands".
-include Makefile.local
